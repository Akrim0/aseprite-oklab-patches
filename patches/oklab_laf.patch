+// LAF Gfx Library
+// Copyright (c) 2020-2022  Igara Studio S.A.
+// Copyright (c) 2017  David Capello
+//
+// This file is released under the terms of the MIT license.
+// Read LICENSE.txt for more information.
+
+#ifdef HAVE_CONFIG_H
+  #include "config.h"
+#endif
+
+#include "gfx/okhsl.h"
+#include "gfx/oklab.h"
+#include "gfx/rgb.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace gfx {
+
+using namespace std;
+
+OkHsl::OkHsl(double hue, double saturation, double lightness)
+  : m_hue(hue)
+  , m_saturation(std::clamp(saturation, 0.0, 1.0))
+  , m_lightness(std::clamp(lightness, 0.0, 1.0))
+{
+}
+
+OkHsl::OkHsl(const Rgb& rgb)
+{
+  oklab::HSL okhsl = oklab::srgb_to_okhsl(oklab::RGB{
+    double(rgb.red()) / 255.0, 
+    double(rgb.green()) / 255.0, 
+    double(rgb.blue()) / 255.0
+  });
+
+  m_hue = okhsl.h;
+  m_saturation = okhsl.s;
+  m_lightness = okhsl.l;
+}
+
+int OkHsl::hueInt() const
+{
+  return int(std::floor(m_hue + 0.5));
+}
+
+int OkHsl::saturationInt() const
+{
+  return int(std::floor(m_saturation * 100.0 + 0.5));
+}
+
+int OkHsl::lightnessInt() const
+{
+  return int(std::floor(m_lightness * 100.0 + 0.5));
+}
+
+} // namespace gfx
