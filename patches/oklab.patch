+double Color::getOkHslHue() const 
+{
+
+  switch (getType()) {
+    case Color::MaskType:  return 0.0;
+
+    case Color::RgbType:   return OkHsl(Rgb(m_value.rgb.r, m_value.rgb.g, m_value.rgb.b)).hue();
+
+    case Color::HsvType:   return OkHsl(Rgb(getRed(), getGreen(), getBlue())).hue();
+
+    case Color::HslType:   return OkHsl(Rgb(getRed(), getGreen(), getBlue())).hue();
+
+    case Color::OkHslType: return m_value.okhsl.h;
+
+    case Color::GrayType:  return 0.0;
+
+    case Color::IndexType: {
+      int i = m_value.index;
+      if (i >= 0 && i < get_current_palette()->size()) {
+        uint32_t c = get_current_palette()->getEntry(i);
+        return OkHsl(Rgb(rgba_getr(c), rgba_getg(c), rgba_getb(c))).hue();
+      }
+      else
+        return 0.0;
+    }
+  }
+
+  ASSERT(false);
+  return -1.0;
+}
+
+double Color::getOkHslSaturation() const
+{
+  switch (getType()) {
+    case Color::MaskType:  return 0;
+
+    case Color::RgbType:   return OkHsl(Rgb(m_value.rgb.r, m_value.rgb.g, m_value.rgb.b)).saturation();
+
+    case Color::HsvType:   return OkHsl(Rgb(getRed(), getGreen(), getBlue())).saturation();
+
+    case Color::HslType:   return OkHsl(Rgb(getRed(), getGreen(), getBlue())).saturation();
+
+    case Color::OkHslType: return m_value.okhsl.s;
+
+    case Color::GrayType:  return 0;
+
+    case Color::IndexType: {
+      int i = m_value.index;
+      if (i >= 0 && i < get_current_palette()->size()) {
+        uint32_t c = get_current_palette()->getEntry(i);
+        return OkHsl(Rgb(rgba_getr(c), rgba_getg(c), rgba_getb(c))).saturation();
+      }
+      else
+        return 0.0;
+    }
+  }
+
+  ASSERT(false);
+  return -1.0;
+}
+
+double Color::getOkHslLightness() const
+{
+  switch (getType()) {
+    case Color::MaskType:  return 0.0;
+
+    case Color::RgbType:   return OkHsl(Rgb(m_value.rgb.r, m_value.rgb.g, m_value.rgb.b)).lightness();
+
+    case Color::HsvType:   return OkHsl(Rgb(getRed(), getGreen(), getBlue())).lightness();
+
+    case Color::HslType:   return OkHsl(Rgb(getRed(), getGreen(), getBlue())).lightness();
+
+    case Color::OkHslType: return m_value.okhsl.l;
+
+    case Color::GrayType:  return m_value.gray.g / 255.0;
+
+    case Color::IndexType: {
+      int i = m_value.index;
+      if (i >= 0 && i < get_current_palette()->size()) {
+        uint32_t c = get_current_palette()->getEntry(i);
+        return OkHsl(Rgb(rgba_getr(c), rgba_getg(c), rgba_getb(c))).lightness();
+      }
+      else
+        return 0.0;
+    }
+  }
+
+  ASSERT(false);
+  return -1.0;
+}
