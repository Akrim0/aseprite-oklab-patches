+inline constexpr char kOKHSL_to_RGB_sksl[] = R"(
+// -----------------------------------------------------------------------
+// OKLab / OKHSL -> sRGB conversion utilities for SkSL (Skia)
+//
+// Ported from the public-domain reference implementation by Björn Ottosson:
+// https://bottosson.github.io/posts/colorpicker/
+// https://bottosson.github.io/posts/gamutclipping/
+//
+// Conventions:
+//  - lab.x = L, lab.y = a, lab.z = b   (OKLab)
+//  - hsl.x = h [0,1], hsl.y = s [0,1], hsl.z = l [0,1]   (OKHSL)
+//  - "a, b" arguments to find_cusp / find_gamut_intersection / get_Cs
+//    must be a unit vector on the OKLab a/b plane (i.e. a*a + b*b == 1),
+//    since they represent a pure hue direction.
+//  - Output rgb is in [0,1] (may go outside if the source color is out
+//    of gamut — clip/tonemap externally if needed).
+// -----------------------------------------------------------------------
+
+// Signed cube root — pow() is undefined for negative bases in GLSL/SkSL.
+float cbrt_(float x) {
+    return sign(x) * pow(abs(x), 1.0 / 3.0);
+}
+
+// OKLab -> linear sRGB
+vec3 oklab_to_linear_srgb(vec3 lab) {
+    float L = lab.x;
+    float a = lab.y;
+    float b = lab.z;
+
+    float l_ = L + 0.3963377774 * a + 0.2158037573 * b;
+    float m_ = L - 0.1055613458 * a - 0.0638541728 * b;
+    float s_ = L - 0.0894841775 * a - 1.2914855480 * b;
+
+    float l = l_ * l_ * l_;
+    float m = m_ * m_ * m_;
+    float s = s_ * s_ * s_;
+
+    return vec3(
+        4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+       -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+       -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
+    );
+}
+
+// Toe function: maps OKLab L to a more perceptually-uniform lightness L_r.
+float toe(float x) {
+    const float k_1 = 0.206;
+    const float k_2 = 0.03;
+    const float k_3 = (1.0 + k_1) / (1.0 + k_2);
+    return 0.5 * (k_3 * x - k_1 +
+        sqrt((k_3 * x - k_1) * (k_3 * x - k_1) + 4.0 * k_2 * k_3 * x));
+}
+
+// Inverse toe function: L_r -> OKLab L.
+float toe_inv(float x) {
+    const float k_1 = 0.206;
+    const float k_2 = 0.03;
+    const float k_3 = (1.0 + k_1) / (1.0 + k_2);
+    return (x * x + k_1 * x) / (k_3 * (x + k_2));
+}
+
+// Finds the maximum saturation (S = C/L) possible for a given hue that
+// still fits inside sRGB. a, b must be a unit vector (a*a + b*b == 1).
+float compute_max_saturation(float a, float b) {
+    float k0, k1, k2, k3, k4, wl, wm, ws;
+
+    if (-1.88170328 * a - 0.80936493 * b > 1.0) {
+        // Red component goes out of gamut first
+        k0 = 1.19086277; k1 =  1.76576728; k2 = 0.59662641; k3 = 0.75515197; k4 = 0.56771245;
+        wl =  4.0767416621; wm = -3.3077115913; ws =  0.2309699292;
+    } else if (1.81444104 * a - 1.19445276 * b > 1.0) {
+        // Green component goes out of gamut first
+        k0 = 0.73956515; k1 = -0.45954404; k2 = 0.08285427; k3 = 0.12541070; k4 = 0.14503204;
+        wl = -1.2684380046; wm =  2.6097574011; ws = -0.3413193965;
+    } else {
+        // Blue component goes out of gamut first
+        k0 = 1.35733652; k1 = -0.00915799; k2 = -1.15130210; k3 = -0.50559606; k4 = 0.00692167;
+        wl = -0.0041960863; wm = -0.7034186147; ws =  1.7076147010;
+    }
+
+    // Polynomial approximation of max saturation
+    float S = k0 + k1 * a + k2 * b + k3 * a * a + k4 * a * b;
+
+    // One step of Halley's method to refine the estimate
+    float k_l =  0.3963377774 * a + 0.2158037573 * b;
+    float k_m = -0.1055613458 * a - 0.0638541728 * b;
+    float k_s = -0.0894841775 * a - 1.2914855480 * b;
+
+    float l_ = 1.0 + S * k_l;
+    float m_ = 1.0 + S * k_m;
+    float s_ = 1.0 + S * k_s;
+
+    float l = l_ * l_ * l_;
+    float m = m_ * m_ * m_;
+    float s = s_ * s_ * s_;
+
+    float l_dS = 3.0 * k_l * (l_ * l_);
+    float m_dS = 3.0 * k_m * (m_ * m_);
+    float s_dS = 3.0 * k_s * (s_ * s_);
+
+    float l_dS2 = 6.0 * (k_l * k_l) * l_;
+    float m_dS2 = 6.0 * (k_m * k_m) * m_;
+    float s_dS2 = 6.0 * (k_s * k_s) * s_;
+
+    float f  = wl * l     + wm * m     + ws * s;
+    float f1 = wl * l_dS  + wm * m_dS  + ws * s_dS;
+    float f2 = wl * l_dS2 + wm * m_dS2 + ws * s_dS2;
+
+    S = S - f * f1 / (f1 * f1 - 0.5 * f * f2);
+
+    return S;
+}
+
+// Finds L_cusp and C_cusp (the point of maximum chroma) for a given hue.
+// a, b must be a unit vector (a*a + b*b == 1).
+// Returns vec2(L_cusp, C_cusp).
+vec2 find_cusp(float a, float b) {
+    float S_cusp = compute_max_saturation(a, b);
+
+    vec3 rgb_at_max = oklab_to_linear_srgb(vec3(1.0, S_cusp * a, S_cusp * b));
+    float L_cusp = cbrt_(1.0 / max(max(rgb_at_max.r, rgb_at_max.g), rgb_at_max.b));
+    float C_cusp = L_cusp * S_cusp;
+
+    return vec2(L_cusp, C_cusp);
+}
+
+// Finds the intersection, on a given hue's gamut boundary, of the line
+// defined by L = L0*(1-t) + t*L1, C = t*C1. Used to find how far a color
+// can go before leaving the sRGB gamut. a, b must be a unit vector.
+float find_gamut_intersection(float a, float b, float L1, float C1, float L0) {
+    vec2 cusp = find_cusp(a, b);
+
+    float t;
+    if (((L1 - L0) * cusp.y - (cusp.x - L0) * C1) <= 0.0) {
+        // Lower half of the gamut triangle
+        t = cusp.y * L0 / (C1 * cusp.x + cusp.y * (L0 - L1));
+    } else {
+        // Upper half: first intersect with the gamut triangle
+        t = cusp.y * (L0 - 1.0) / (C1 * (cusp.x - 1.0) + cusp.y * (L0 - L1));
+
+        // Then refine with one step of Halley's method against the true
+        // (curved) gamut boundary.
+        float dL = L1 - L0;
+        float dC = C1;
+
+        float k_l =  0.3963377774 * a + 0.2158037573 * b;
+        float k_m = -0.1055613458 * a - 0.0638541728 * b;
+        float k_s = -0.0894841775 * a - 1.2914855480 * b;
+
+        float l_dt = dL + dC * k_l;
+        float m_dt = dL + dC * k_m;
+        float s_dt = dL + dC * k_s;
+
+        float L = L0 * (1.0 - t) + t * L1;
+        float C = t * C1;
+
+        float l_ = L + C * k_l;
+        float m_ = L + C * k_m;
+        float s_ = L + C * k_s;
+
+        float l = l_ * l_ * l_;
+        float m = m_ * m_ * m_;
+        float s = s_ * s_ * s_;
+
+        float ldt = 3.0 * l_dt * (l_ * l_);
+        float mdt = 3.0 * m_dt * (m_ * m_);
+        float sdt = 3.0 * s_dt * (s_ * s_);
+
+        float ldt2 = 6.0 * (l_dt * l_dt) * l_;
+        float mdt2 = 6.0 * (m_dt * m_dt) * m_;
+        float sdt2 = 6.0 * (s_dt * s_dt) * s_;
+
+        float r  =  4.0767416621 * l    - 3.3077115913 * m    + 0.2309699292 * s    - 1.0;
+        float r1 =  4.0767416621 * ldt  - 3.3077115913 * mdt  + 0.2309699292 * sdt;
+        float r2 =  4.0767416621 * ldt2 - 3.3077115913 * mdt2 + 0.2309699292 * sdt2;
+        float u_r = r1 / (r1 * r1 - 0.5 * r * r2);
+        float t_r = -r * u_r;
+
+        float g  = -1.2684380046 * l    + 2.6097574011 * m    - 0.3413193965 * s    - 1.0;
+        float g1 = -1.2684380046 * ldt  + 2.6097574011 * mdt  - 0.3413193965 * sdt;
+        float g2 = -1.2684380046 * ldt2 + 2.6097574011 * mdt2 - 0.3413193965 * sdt2;
+        float u_g = g1 / (g1 * g1 - 0.5 * g * g2);
+        float t_g = -g * u_g;
+
+        float bch = -0.0041960863 * l    - 0.7034186147 * m    + 1.7076147010 * s    - 1.0;
+        float b1  = -0.0041960863 * ldt  - 0.7034186147 * mdt  + 1.7076147010 * sdt;
+        float b2  = -0.0041960863 * ldt2 - 0.7034186147 * mdt2 + 1.7076147010 * sdt2;
+        float u_b = b1 / (b1 * b1 - 0.5 * bch * b2);
+        float t_b = -bch * u_b;
+
+        const float FLT_MAX = 3.4028235e+38;
+        t_r = u_r >= 0.0 ? t_r : FLT_MAX;
+        t_g = u_g >= 0.0 ? t_g : FLT_MAX;
+        t_b = u_b >= 0.0 ? t_b : FLT_MAX;
+
+        t += min(t_r, min(t_g, t_b));
+    }
+
+    return t;
+}
+
+// Returns vec3(C_0, C_mid, C_max): reference chroma values used to build
+// the OKHSL saturation mapping for lightness L and hue direction (a, b).
+// a, b must be a unit vector (a*a + b*b == 1).
+vec3 get_Cs(float L, float a, float b) {
+    vec2 cusp = find_cusp(a, b);
+
+    float C_max = find_gamut_intersection(a, b, L, 1.0, L);
+
+    float S_max = cusp.y / cusp.x;
+    float T_max = cusp.y / (1.0 - cusp.x);
+
+    // Scale factor compensating for the curved part of the gamut shape
+    float k = C_max / min(L * S_max, (1.0 - L) * T_max);
+
+    float C_mid;
+    {
+        // Smooth polynomial approximation of the mid-point cusp location
+        // (fit by Ottosson so that S_mid < S_max and T_mid < T_max)
+        float S = 0.11516993 + 1.0 / (
+            7.44778970 + 4.15901240 * b +
+            a * (-2.19557347 + 1.75198401 * b +
+            a * (-2.13704948 - 10.02301043 * b +
+            a * (-4.24894561 + 5.38770819 * b + 4.69891013 * a))));
+
+        float T = 0.11239642 + 1.0 / (
+            1.61320320 - 0.68124379 * b +
+            a * (0.40370612 + 0.90148123 * b +
+            a * (-0.27087943 + 0.61223990 * b +
+            a * (0.00299215 - 0.45399568 * b - 0.14661872 * a))));
+
+        float C_a = L * S;
+        float C_b = (1.0 - L) * T;
+
+        // Soft-min blend for a smooth chroma value
+        C_mid = 0.9 * k * sqrt(sqrt(
+            1.0 / (1.0 / (C_a * C_a * C_a * C_a) + 1.0 / (C_b * C_b * C_b * C_b))));
+    }
+
+    float C_0;
+    {
+        // C_0's shape is roughly hue-independent; constants are average S/T
+        float C_a = L * 0.4;
+        float C_b = (1.0 - L) * 0.8;
+
+        C_0 = sqrt(1.0 / (1.0 / (C_a * C_a) + 1.0 / (C_b * C_b)));
+    }
+
+    return vec3(C_0, C_mid, C_max);
+}
+
+// OKHSL -> OKLab. hsl = (h [0,1], s [0,1], l [0,1])
+vec3 okhsl_to_oklab(vec3 hsl) {
+    float h = hsl.x;
+    float s = hsl.y;
+    float l = hsl.z;
+
+    float L = toe_inv(l);
+    float a = 0.0;
+    float b = 0.0;
+
+    if (L != 0.0 && L != 1.0 && s != 0.0) {
+        float a_ = cos(6.28318530718 * h);
+        float b_ = sin(6.28318530718 * h);
+
+        vec3 cs = get_Cs(L, a_, b_);
+        float C_0   = cs.x;
+        float C_mid = cs.y;
+        float C_max = cs.z;
+
+        const float mid = 0.8;
+        const float mid_inv = 1.25;
+
+        float C, t;
+        if (s < mid) {
+            t = mid_inv * s;
+
+            float k_1 = mid * C_0;
+            float k_2 = 1.0 - k_1 / C_mid;
+
+            C = t * k_1 / (1.0 - k_2 * t);
+        } else {
+            t = (s - mid) / (1.0 - mid);
+
+            float k_0 = C_mid;
+            float k_1 = (1.0 - mid) * C_mid * C_mid * mid_inv * mid_inv / C_0;
+            float k_2 = 1.0 - k_1 / (C_max - C_mid);
+
+            C = k_0 + t * k_1 / (1.0 - k_2 * t);
+        }
+
+        a = C * a_;
+        b = C * b_;
+    }
+
+    return vec3(L, a, b);
+}
+
+// Componentwise sRGB OETF (linear -> gamma-encoded sRGB), clamped to [0,1].
+vec3 srgb_transfer_function(vec3 rgb) {
+    vec3 lo = 12.92 * rgb;
+    vec3 hi = 1.055 * pow(max(rgb, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
+    vec3 useHi = step(vec3(0.0031308), rgb); // 0 -> use lo, 1 -> use hi
+    return clamp(mix(lo, hi, useHi), 0.0, 1.0);
+}
+
+// OKLab -> gamma-encoded sRGB
+vec3 oklab_to_srgb(vec3 lab) {
+    vec3 lin = oklab_to_linear_srgb(lab);
+    return srgb_transfer_function(lin);
+}
+
+// OKHSL -> gamma-encoded sRGB
+vec3 okhsl_to_srgb(vec3 hsl) {
+    vec3 lab = okhsl_to_oklab(hsl);
+    return oklab_to_srgb(lab);
+}
